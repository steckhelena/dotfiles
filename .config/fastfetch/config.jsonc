{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Ported from the old neofetch config.conf.
  // ascii distro logo, auto-detected  (was: image_backend="ascii", ascii_distro="auto")
  "logo": {
    "type": "auto",
    "padding": {
      "right": 3  // was: gap=3
    }
  },

  "display": {
    "separator": ": "  // was: separator=":"
  },

  "modules": [
    // top colour swatch row  (was: prin "$(color 1)... $(color 6)...")
    { "type": "custom", "format": "\u001b[31m \u001b[32m \u001b[33m \u001b[34m \u001b[35m \u001b[36m \u001b[0m" },
    "break",
    { "type": "os", "key": " ", "keyColor": "blue" },
    // { "type": "host", "key": "Host" },  // was commented out in neofetch
    { "type": "kernel", "key": " ", "keyColor": "red" },
    { "type": "uptime", "key": " ", "keyColor": "yellow" },
    { "type": "packages", "key": " ", "keyColor": "green" },
    { "type": "shell", "key": " ", "keyColor": "white" },
    { "type": "wm", "key": " ", "keyColor": "magenta" },
    { "type": "terminal", "key": " " },
    { "type": "terminalfont", "key": " ", "keyColor": "cyan" },
    { "type": "cpu", "key": "󰘚 " },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "󰨅 " },
    "break",
    // bottom colour swatch row
    { "type": "custom", "format": "\u001b[31m \u001b[32m \u001b[33m \u001b[34m \u001b[35m \u001b[36m \u001b[0m" }
  ]
}
